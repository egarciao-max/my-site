{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enrique-personal-site",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  }
}
